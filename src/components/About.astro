---
import { aboutText } from '../data/site';
---

<section id="nosotros" class="scroll-mt-24 py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <p class="section-label mb-3">Sobre la banda</p>
    <h2 class="display-title mb-8 text-4xl text-theme sm:text-5xl md:text-6xl">
      Nosotros
    </h2>

    <div class="max-w-3xl space-y-5">
      <p class="text-lg leading-relaxed text-theme sm:text-xl">
        {aboutText.lead}
      </p>
      {
        aboutText.paragraphs.map((p) => (
          <p class="leading-relaxed text-theme-muted">{p}</p>
        ))
      }
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-3">
      <div class="border border-theme p-5">
        <p class="display-title mb-1 text-4xl text-accent">10</p>
        <p class="text-sm text-theme-muted">Canciones en La espera</p>
      </div>
      <div class="border border-theme p-5">
        <p class="display-title mb-1 text-4xl text-accent">2024</p>
        <p class="text-sm text-theme-muted">Disco debut</p>
      </div>
      <div class="border border-theme p-5">
        <p class="display-title mb-1 text-4xl text-accent">CBA</p>
        <p class="text-sm text-theme-muted">De Córdoba al mundo</p>
      </div>
    </div>
  </div>
</section>

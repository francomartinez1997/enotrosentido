---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="eos-footer mono">
  <span>{site.name} · {site.tagline}</span>
  <div class="eos-footer__links">
    <a href={site.social.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
    <a href={site.social.tiktok} target="_blank" rel="noopener noreferrer">TikTok</a>
    <a href={site.social.youtube} target="_blank" rel="noopener noreferrer">YouTube</a>
    <a href={site.social.linktree} target="_blank" rel="noopener noreferrer">Linktree</a>
  </div>
  <span>© {year}</span>
</footer>

<style>
  .eos-footer {
    border-top: 1px solid var(--line);
    padding: 36px 40px;
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    justify-content: space-between;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .eos-footer__links {
    display: flex;
    gap: 20px;
  }

  .eos-footer a:hover {
    color: var(--acc);
  }
</style>

---
import { site } from '../data/site';

const themes = [
  { key: 'oscuro', name: 'Oscuro', swatch: '#0a0a0c' },
  { key: 'claro', name: 'Claro', swatch: '#efece4' },
  { key: 'sangre', name: 'Rojo', swatch: 'oklch(0.55 0.235 26)' },
];
---

<aside class="v2-rail">
  <a href="#top" class="rail-logo" aria-label={site.name}>{site.shortName}</a>

  <nav class="rail-nav mono" aria-label="Principal">
    {
      site.nav.map((item) => (
        <a href={item.href} class:list={[item.accent && 'is-accent']}>
          {item.label}
        </a>
      ))
    }
  </nav>

  <div class="rail-theme">
    <span class="mono rail-theme-tag">Tema</span>
    <span class="rail-theme-sep"></span>
    {
      themes.map((t) => (
        <button
          type="button"
          class="theme-swatch"
          data-theme-key={t.key}
          style={`background:${t.swatch}`}
          title={`Tema ${t.name}`}
          aria-label={`Tema ${t.name}`}
        />
      ))
    }
    <span class="rail-theme-name mono eos-theme-name">Oscuro</span>
  </div>
</aside>

<script>
  const swatches = Array.from(document.querySelectorAll<HTMLButtonElement>('.theme-swatch'));
  const nameEls = Array.from(document.querySelectorAll<HTMLElement>('.eos-theme-name'));
  const names: Record<string, string> = { oscuro: 'Oscuro', claro: 'Claro', sangre: 'Rojo' };

  function applyTheme(theme: string) {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('eos-theme', theme);
    nameEls.forEach((el) => {
      el.textContent = names[theme] ?? theme;
    });
    swatches.forEach((btn) => {
      btn.classList.toggle('is-active', btn.dataset.themeKey === theme);
    });
  }

  const current = document.documentElement.getAttribute('data-theme') || 'oscuro';
  applyTheme(current);

  swatches.forEach((btn) => {
    btn.addEventListener('click', () => applyTheme(btn.dataset.themeKey || 'oscuro'));
  });
</script>

<style>
  .v2-rail {
    position: sticky;
    top: 0;
    height: 100vh;
    width: var(--rail-w);
    z-index: 800;
    border-right: 1px solid var(--line);
    background: var(--bg);
    display: grid;
    grid-template-rows: auto 1fr auto;
    justify-items: center;
    padding: 22px 0;
  }

  .rail-logo {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    background: var(--acc);
    color: #fff;
    font-family: 'Space Mono', monospace;
    font-size: 13px;
    font-weight: 700;
    clip-path: polygon(0 0, 100% 0, 100% 72%, 72% 100%, 0 100%);
  }

  .rail-nav {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 30px;
    writing-mode: vertical-rl;
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .rail-nav .is-accent {
    color: var(--acc);
  }

  .rail-theme {
    display: grid;
    gap: 12px;
    justify-items: center;
  }

  .rail-theme-tag {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--acc);
    background: var(--fg);
    writing-mode: vertical-rl;
    padding: 10px 5px;
  }

  .rail-theme-sep {
    width: 1px;
    height: 14px;
    background: var(--line);
    display: block;
  }

  .rail-theme-name {
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--acc);
    writing-mode: vertical-rl;
    margin-top: 4px;
  }
</style>

---
import { site } from '../data/site';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-theme-header">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6">
    <a href="#" class="display-title text-xl text-theme sm:text-2xl">
      {site.shortName}
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Principal">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            class="text-sm text-theme-muted transition-colors hover:text-theme"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <button
        type="button"
        id="theme-toggle"
        class="theme-toggle"
        aria-label="Cambiar a modo claro"
      >
        <svg
          class="theme-icon-sun"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3v2m0 14v2M4.22 4.22l1.42 1.42m12.72 12.72 1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z"
          ></path>
        </svg>
        <svg
          class="theme-icon-moon"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
          ></path>
        </svg>
      </button>

      <a
        href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hola EOS! Quiero contactarlos.')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary rounded-full px-3 py-2 text-xs font-semibold sm:px-4 sm:text-sm"
      >
        Escribinos
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('theme-toggle');

  function applyTheme(theme) {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
    if (toggle) {
      toggle.setAttribute(
        'aria-label',
        theme === 'dark' ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro',
      );
    }
  }

  toggle?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme');
    applyTheme(current === 'light' ? 'dark' : 'light');
  });
</script>

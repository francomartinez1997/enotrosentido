---
import { site, heroImage } from '../data/site';
---

<section class="pt-28 pb-16 md:pt-32 md:pb-24">
  <div
    class="mx-auto grid max-w-6xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14"
  >
    <div class="relative order-2 lg:order-1">
      <div class="shape-arch relative aspect-[4/5] max-h-[70vh] overflow-hidden border border-theme">
        <img
          src={heroImage}
          alt="En otro sentido — foto de la banda"
          class="h-full w-full object-cover"
          loading="eager"
        />
      </div>

      <a
        href={site.social.spotify}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary absolute bottom-4 right-4 flex h-16 w-16 items-center justify-center rounded-full text-xs font-bold uppercase tracking-wider"
        aria-label="Escuchar en Spotify"
      >
        Play
      </a>
    </div>

    <div class="order-1 flex flex-col gap-5 lg:order-2 lg:py-8">
      <p class="section-label">{site.tagline}</p>

      <h1 class="hero-title text-[clamp(2.75rem,10vw,5.5rem)]">
        <span class="block text-theme">En otro</span>
        <span class="block text-accent">sentido</span>
      </h1>

      <p class="max-w-md text-base leading-relaxed text-theme-muted sm:text-lg">
        Rock moderno desde Córdoba, Argentina. Primer disco <em>La espera</em> — un viaje
        sonoro entre amistad, romance y el presente.
      </p>

      <div class="flex flex-wrap gap-3 pt-1">
        <a href="#musica" class="btn-primary rounded-full px-6 py-3 text-sm font-semibold">
          Escuchar ahora
        </a>
        <a href="#galeria" class="btn-secondary rounded-full px-6 py-3 text-sm font-semibold">
          Ver galería
        </a>
      </div>
    </div>
  </div>
</section>

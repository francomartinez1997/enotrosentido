---
import { songs } from '../data/site';
---

<section id="letra" data-reveal="1" class="eos-section letra">
  <div class="letra-head">
    <span class="mono eos-eyebrow">03 / Letra</span>
    <span class="mono letra-nav" id="eos-letra-nav">01 / 0{songs.length}</span>
  </div>

  <div class="letra-grid">
    <div class="letra-list">
      {
        songs.map((s, idx) => (
          <button
            type="button"
            class="letra-song"
            class:list={[idx === 0 && 'is-active']}
            data-index={idx}
          >
            <span class="mono letra-song__num">{String(idx + 1).padStart(2, '0')}</span>
            <span class="letra-song__title">{s.title}</span>
          </button>
        ))
      }
    </div>

    <div class="letra-view">
      {
        songs.map((s, idx) => (
          <pre class="letra-text" data-song={idx} style={idx === 0 ? '' : 'display:none'}>{s.lyrics}</pre>
        ))
      }
      <span class="mono letra-placeholder-note">[ placeholder — mandame las letras reales ]</span>
    </div>
  </div>
</section>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.letra-song'));
  const texts = Array.from(document.querySelectorAll<HTMLPreElement>('.letra-text'));
  const nav = document.getElementById('eos-letra-nav');
  const total = buttons.length;

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = btn.dataset.index;
      buttons.forEach((b) => b.classList.toggle('is-active', b === btn));
      texts.forEach((t) => {
        t.style.display = t.dataset.song === idx ? '' : 'none';
      });
      if (nav && idx !== undefined) {
        nav.textContent = `${String(Number(idx) + 1).padStart(2, '0')} / 0${total}`;
      }
    });
  });
</script>

<style>
  .letra {
    background: var(--bg2);
    display: grid;
    gap: 40px;
  }

  .letra-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 18px;
  }

  .letra-nav {
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .letra-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 40px;
    align-items: start;
  }

  .letra-list {
    display: grid;
    gap: 2px;
    align-content: start;
  }

  .letra-song {
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 12px;
    align-items: center;
    text-align: left;
    padding: 20px 18px;
    cursor: pointer;
    border: 0;
    border-left: 3px solid transparent;
    background: transparent;
    color: var(--fg);
    opacity: 0.55;
  }

  .letra-song.is-active {
    border-left-color: var(--acc);
    background: rgba(255, 255, 255, 0.06);
    opacity: 1;
  }

  .letra-song__num {
    font-size: 10px;
  }

  .letra-song__title {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .letra-view {
    display: grid;
    gap: 22px;
    align-content: start;
    min-height: 300px;
  }

  .letra-text {
    margin: 0;
    font-family: 'Archivo', Helvetica, sans-serif;
    font-size: clamp(22px, 2.6vw, 38px);
    line-height: 1.32;
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: pre-wrap;
  }

  .letra-placeholder-note {
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--dim);
    border-top: 1px dashed var(--line);
    padding-top: 14px;
  }
</style>

---
import { externalLinks } from '../data/site';
---

<section id="links" class="scroll-mt-24 py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <p class="section-label mb-3">Enlaces</p>
    <h2 class="display-title mb-8 text-4xl text-theme sm:text-5xl md:text-6xl">
      Encontranos
    </h2>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        externalLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="card-hover group border border-theme p-5 transition"
          >
            <h3 class="card-title mb-1 font-semibold text-theme transition">
              {link.title}
            </h3>
            <p class="text-sm text-theme-muted">{link.description}</p>
            <span class="mt-3 inline-block text-xs uppercase tracking-wider text-accent">
              Abrir →
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

---
import { quickLinks } from '../data/site';
---

<section id="links" data-reveal="1" class="eos-section links">
  <span class="mono eos-eyebrow">06 / Links</span>

  <div class="links-grid">
    {
      quickLinks.map((l) => (
        <a href={l.href} target="_blank" rel="noopener noreferrer" class="links-item">
          <span class="mono links-item__kind">{l.kind}</span>
          <span class="links-item__label">{l.label}</span>
          <span class="mono links-item__arrow">↗</span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .links {
    background: var(--bg2);
    display: grid;
    gap: 30px;
  }

  .links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 2px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .links-item {
    background: var(--bg2);
    padding: 28px 24px;
    display: grid;
    gap: 10px;
    align-content: space-between;
    min-height: 148px;
    transition:
      background 0.22s,
      color 0.22s;
  }

  .links-item:hover {
    background: var(--acc);
    color: #fff;
  }

  .links-item__kind {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .links-item__label {
    font-size: 26px;
    font-weight: 900;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .links-item__arrow {
    font-size: 11px;
  }
</style>

---
import { site } from '../data/site';
---

<section id="musica" class="scroll-mt-24 py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div
      class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"
    >
      <div>
        <p class="section-label mb-3">Escuchá</p>
        <h2 class="display-title text-4xl text-theme sm:text-5xl md:text-6xl">
          Música
        </h2>
      </div>
      <a
        href={site.social.spotify}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-accent transition hover:text-theme"
      >
        Abrir en Spotify →
      </a>
    </div>

    <div class="grid gap-6 lg:grid-cols-2 lg:items-start">
      <div class="overflow-hidden border border-theme">
        <p class="border-b border-theme px-4 py-3 text-sm text-theme-muted">
          Destacado · Cuánto más
        </p>
        <iframe
          class="spotify-embed block w-full max-w-full"
          style="border: 0;"
          src={`https://open.spotify.com/embed/track/${site.spotify.featuredTrack}?utm_source=generator&theme=0`}
          height="352"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"
          title="Spotify — Cuánto más"></iframe>
      </div>

      <div class="overflow-hidden border border-theme">
        <p class="border-b border-theme px-4 py-3 text-sm text-theme-muted">
          Álbum · La espera (2024)
        </p>
        <iframe
          class="spotify-embed block w-full max-w-full"
          style="border: 0;"
          src={`https://open.spotify.com/embed/album/${site.spotify.album}?utm_source=generator&theme=0`}
          height="352"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"
          title="Spotify — La espera"></iframe>
      </div>
    </div>

    <div class="mt-10 md:mt-12">
      <div
        class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between"
      >
        <p class="text-sm text-theme-muted">En vivo · En tus ojos · Pez Volcán 2024</p>
        <a
          href={site.youtube.enVivoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-accent transition hover:text-theme"
        >
          Ver en YouTube →
        </a>
      </div>
      <div class="overflow-hidden border border-theme">
        <iframe
          class="youtube-embed aspect-video w-full"
          src={`https://www.youtube.com/embed/${site.youtube.enVivo}`}
          title="YouTube — En tus ojos en vivo"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
          loading="lazy"></iframe>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var desktop = window.matchMedia('(min-width: 1024px)');

    function syncSpotifyHeights() {
      var height = desktop.matches ? 352 : 152;

      document.querySelectorAll('.spotify-embed').forEach(function (iframe) {
        iframe.setAttribute('height', String(height));
        iframe.style.height = height + 'px';
      });
    }

    syncSpotifyHeights();
    desktop.addEventListener('change', syncSpotifyHeights);
  })();
</script>

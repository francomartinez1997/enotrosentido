---
import { site, releases } from '../data/site';
---

<section id="disco" data-reveal="1" class="eos-section disco">
  <div class="disco-head">
    <div class="disco-head__title">
      <span class="mono eos-eyebrow">02 / Disco</span>
      <h2 class="eos-h2 disco-h2">La espera</h2>
    </div>
    <a href={site.social.spotify} target="_blank" rel="noopener noreferrer" class="mono disco-spotify-link">
      Spotify ↗
    </a>
  </div>

  <div class="disco-grid">
    <div class="disco-embeds">
      <span class="mono disco-embeds__label">Destacado · Cuánto más</span>
      <div class="disco-embeds__frame-wrap disco-embeds__frame-wrap--track">
        <iframe
          class="disco-embeds__frame"
          src={`https://open.spotify.com/embed/track/${site.spotify.featuredTrack}?utm_source=generator&theme=0`}
          width="100%"
          height="152"
          frameborder="0"
          loading="lazy"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          title="Spotify — Cuánto más"></iframe>
      </div>

      <span class="mono disco-embeds__label" style="margin-top:8px;">Álbum completo</span>
      <div class="disco-embeds__frame-wrap">
        <iframe
          class="disco-embeds__frame"
          src={`https://open.spotify.com/embed/album/${site.spotify.album}?utm_source=generator&theme=0`}
          width="100%"
          height="352"
          frameborder="0"
          loading="lazy"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          title="Spotify — La espera"></iframe>
      </div>
    </div>

    <div class="disco-releases">
      {
        releases.map((rel) => (
          <a href={rel.href} target="_blank" rel="noopener noreferrer" class="disco-release">
            <span class="mono disco-release__num">{rel.num}</span>
            <span class="disco-release__info">
              <span class="disco-release__title">{rel.title}</span>
              <span class="mono disco-release__meta">{rel.meta}</span>
            </span>
            <span class="mono disco-release__arrow">↗</span>
          </a>
        ))
      }
      <div class="disco-studio">
        <span class="mono eos-eyebrow">En estudio</span>
        <p class="disco-studio__text">
          <span class="disco-studio__mark"
            >Segundo disco en grabación. Más instinto, menos paciencia.</span
          >
        </p>
      </div>
    </div>
  </div>

  <div class="disco-videos">
    <div class="disco-video">
      <div class="disco-video__frame">
        <iframe
          src={`https://www.youtube.com/embed/${site.youtube.enVivo}`}
          title="En tus ojos · En vivo"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen></iframe>
      </div>
      <span class="mono disco-video__caption">En tus ojos · Pez Volcán 2024</span>
    </div>
    <div class="disco-video">
      <div class="disco-video__frame">
        <iframe
          src={`https://www.youtube.com/embed/${site.youtube.cuantoMas}`}
          title="La espera · Full álbum"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen></iframe>
      </div>
      <span class="mono disco-video__caption">Cuánto más · video oficial</span>
    </div>
  </div>
</section>

<style>
  .disco {
    display: grid;
    gap: 44px;
  }

  .disco-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
  }

  .disco-head__title {
    display: grid;
    gap: 14px;
  }

  .disco-h2 {
    font-size: clamp(40px, 8vw, 132px);
    line-height: 0.84;
    font-stretch: 118%;
    letter-spacing: -0.04em;
  }

  .disco-spotify-link {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--acc);
    padding-bottom: 6px;
  }

  .disco-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 2px;
    background: var(--line);
    border: 1px solid var(--line);
    min-width: 0;
  }

  .disco-embeds {
    background: var(--bg2);
    padding: 26px;
    display: grid;
    gap: 16px;
    align-content: start;
    min-width: 0;
    overflow: hidden;
  }

  .disco-embeds__label {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .disco-embeds__frame-wrap {
    width: 100%;
    overflow: hidden;
  }

  .disco-embeds__frame {
    border: 0;
    display: block;
    width: 100%;
    max-width: 100%;
  }

  @media (max-width: 767px) {
    .disco-embeds {
      padding: 16px;
    }

    .disco-embeds__frame-wrap--track {
      container-type: inline-size;
      height: calc(152px * min(1, 100cqw / 300px));
    }

    .disco-embeds__frame-wrap--track .disco-embeds__frame {
      width: 300px;
      max-width: none;
      transform: scale(min(1, calc(100cqw / 300px)));
      transform-origin: top left;
    }
  }

  .disco-releases {
    background: var(--bg2);
    display: grid;
    align-content: start;
  }

  .disco-release {
    display: grid;
    grid-template-columns: 40px 1fr auto;
    gap: 16px;
    align-items: center;
    padding: 26px;
    border-bottom: 1px solid var(--line);
    transition: background 0.2s;
  }

  .disco-release:hover {
    background: var(--acc);
    color: #fff;
  }

  .disco-release__num {
    font-size: 11px;
    color: var(--acc);
  }

  .disco-release:hover .disco-release__num {
    color: #fff;
  }

  .disco-release__info {
    display: grid;
    gap: 6px;
  }

  .disco-release__title {
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .disco-release__meta {
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.62;
  }

  .disco-release__arrow {
    font-size: 12px;
  }

  .disco-studio {
    padding: 26px;
    display: grid;
    gap: 12px;
  }

  .disco-studio__text {
    margin: 0;
    max-width: 380px;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.65;
  }

  .disco-studio__mark {
    background: var(--acc);
    color: #fff;
    padding: 0.18em 0.42em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  html[data-theme='sangre'] .disco-studio__mark {
    background: var(--fg);
    color: var(--bg);
  }

  .disco-videos {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 34px;
    width: 100%;
  }

  .disco-video {
    display: grid;
    gap: 10px;
    width: 100%;
    justify-self: center;
  }

  @media (min-width: 768px) {
    .disco-video {
      width: 75%;
    }

    .disco-video:first-child {
      justify-self: start;
    }

    .disco-video:nth-child(2) {
      justify-self: end;
    }

    .disco-video:first-child .disco-video__caption {
      text-align: left;
    }

    .disco-video:nth-child(2) .disco-video__caption {
      text-align: right;
    }
  }

  .disco-video__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .disco-video__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .disco-video__caption {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dim);
  }
</style>

---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} — ${site.tagline}`,
  description = site.description,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/x-icon" href="/images/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,100..900;1,62..125,100..900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var t = localStorage.getItem('eos-theme');
        if (t !== 'oscuro' && t !== 'sangre') t = 'oscuro';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
  </head>
  <body>
    <div class="v2-root">
      <div class="eos-cursor" id="eos-cursor" aria-hidden="true"></div>
      <div class="eos-cursor-ring" id="eos-cursor-ring" aria-hidden="true"></div>
      <slot />
    </div>

    <script>
      // Cursor personalizado — solo en dispositivos con puntero fino (mouse/trackpad)
      const cur = document.getElementById('eos-cursor');
      const ring = document.getElementById('eos-cursor-ring');
      const fine = window.matchMedia('(pointer: fine)').matches;

      if (fine && cur && ring) {
        let tx = 0;
        let ty = 0;
        let lx = 0;
        let ly = 0;

        window.addEventListener(
          'mousemove',
          (e) => {
            const hot = e.target instanceof Element && e.target.closest('a,button,input,textarea');
            const s = hot ? 30 : 18;
            cur.style.width = `${s}px`;
            cur.style.height = `${s}px`;
            cur.style.transform = `translate(${e.clientX - s / 2}px,${e.clientY - s / 2}px) rotate(45deg)`;
            tx = e.clientX;
            ty = e.clientY;
            ring.style.opacity = hot ? '1' : '0.45';
          },
          { passive: true },
        );

        const loop = () => {
          lx += (tx - lx) * 0.14;
          ly += (ty - ly) * 0.14;
          ring.style.transform = `translate(${lx - 26}px,${ly - 26}px) rotate(45deg)`;
          requestAnimationFrame(loop);
        };
        loop();
      } else {
        if (cur) cur.style.display = 'none';
        if (ring) ring.style.display = 'none';
      }

      // Reveal-on-scroll compartido por todas las secciones con data-reveal
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                (entry.target as HTMLElement).style.animation =
                  'v2in .85s cubic-bezier(.2,.75,.2,1) forwards';
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1 },
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      }
    </script>

    <style>
      .eos-cursor {
        position: fixed;
        top: 0;
        left: 0;
        width: 18px;
        height: 18px;
        background: var(--acc);
        pointer-events: none;
        z-index: 9999;
        transform: translate(-200px, -200px) rotate(45deg);
        transition:
          width 0.2s,
          height 0.2s,
          opacity 0.2s;
      }

      .eos-cursor-ring {
        position: fixed;
        top: 0;
        left: 0;
        width: 52px;
        height: 52px;
        border: 1px solid var(--acc);
        pointer-events: none;
        z-index: 9998;
        transform: translate(-200px, -200px) rotate(45deg);
        opacity: 0.5;
      }
    </style>
  </body>
</html>
